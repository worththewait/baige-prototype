  "narrative": {
    "northStar": "参考图中的桌面工具目录",
    "overview": "当前桌面版依据用户最初第二张参考图片：白色侧栏、淡蓝白画布与亮蓝导航状态，智能工具页上方为三张深蓝紫几何图片入口，下方为分类三列工具目录。此文档记录已实现的界面，不引入新的设计方向。",
    "keyCharacteristics": [
      "白侧栏与淡蓝白画布",
      "亮蓝选择与焦点状态",
      "深蓝紫技术几何图片",
      "紫色图标、名称、说明组成三列目录"
    ],
    "rules": [],
    "dos": [
      "Do 保留智能工具的三张图片入口与分类三列目录。",
      "Do 使用本地系统字体、内联图标和相对资源路径，保证文件夹离线分发。",
      "Do 对未接入能力显示“正在集成”，保留可见键盘焦点和减少动态效果设置。"
    ],
    "donts": [
      "Don't 将智能工具改回用户已否定的“科研资料工作台”列表方向。",
      "Don't 添加手机版或窄屏重排；当前范围为桌面。",
      "Don't 将本地几何 SVG 替换为需要外部联网或版权授权的图片。"
    ]
  }
